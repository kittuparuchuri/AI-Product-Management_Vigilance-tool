# Environment variables used by Vigilance.
#
# These are SHELL environment variables (the tool does not auto-load this file).
# Set them in your terminal for local runs, or add them as GitHub Actions
# secrets for the deployed workflows. NEVER commit real values.
#
# Windows PowerShell:  $env:GITHUB_TOKEN="..."
# macOS / Linux:       export GITHUB_TOKEN="..."

# GitHub personal access token, for local `--source github` runs.
# A fine-grained token with public-repo read access is enough.
GITHUB_TOKEN=github_pat_replace_me

# Optional: Slack Incoming Webhook for flagged-reviewer alerts.
# If unset, alerts print to the console instead of posting to Slack.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/ME/HERE
